import { ResizeBox } from "../primitives/resize-box.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Modal, Progress } from "../primitives/modal.slint";
import { IconButton } from "../primitives/panel.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { StylePicker, TextPresetData } from "../inspector/style-picker.slint";

/// The captions' look: a text preset, searched for in the list the Text
/// page's Styles and Languages draw from. A global, as the font picker's
/// search is, so the phone's sheet and the desk's Library page read one
/// list without it being handed down through either.
export global CaptionStyles {
    /// The presets the search lets through.
    in property <[TextPresetData]> matches;
    /// The one the captions are set in.
    in property <TextPresetData> current;
    callback query-changed(text: string);
    callback picked(id: string);
}

// Captions: what the tray's Captions tool opens.
//
// Two sheets in one, and a switch between them: "Use Sample Voice".
// On, the words are a clip's: one picked from the timeline's clips that
// have sound, through the transcriber, cut to the words' own timing. Off,
// they are a script typed here, one title per sentence at reading pace,
// laid down from the playhead. The list holds only clips with sound, so a
// silent video cannot be sent to the transcriber. The switch starts on
// when the sheet is opened on a clip with sound - from the clip's menu, or
// with one selected - and off otherwise. Then where the lines sit and how
// big they are, and one button. While it runs
// the sheet is the progress report: a transcription knows how far through
// the sound it is, so it gets a real bar and not a sweep. The language is
// the transcriber's to hear unless one is picked: whisper hears Indonesian
// as Malay often enough that a person who knows should be able to say so.
// The pick is remembered, and an English-only model has English alone.
//
// On a desk it lives in the Library, on the Text & Captions page under
// Captions (see CaptionsForm): the timeline stays live beside it, so the
// clip it transcribes follows the selection - a clip with sound selected
// is the one shown and run. A transcription goes on whatever page is up,
// and the page shows it when it is back. On a phone, and in a window too
// narrow for the library beside the work, it is a sheet.

/// One caption of the transcript.
export struct CaptionRowData {
    /// Where it shows, as minutes, seconds and tenths.
    time: string,
    /// Where it goes.
    until: string,
    /// Its words.
    text: string,
    /// The playhead is on it.
    current: bool,
}

export struct CaptionsSheetData {
    /// The transcript: the captions' lane's titles in the order they play.
    rows: [CaptionRowData],
    open: bool,
    /// "Use Sample Voice": the words come from a clip's sound.
    from-voice: bool,
    /// The timeline's clips with sound, by file and start.
    sources: [string],
    /// Row in `sources` of the clip to transcribe; -1 for none.
    source: int,
    text: string,
    /// Row in the installed transcriber list.
    model: int,
    /// Row in the language list: 0 is "Auto-detect".
    language: int,
    /// The model hears only English: the list is that, and not a choice.
    language-fixed: bool,
    /// 0 Bottom, 1 Centre, 2 Top
    placement: int,
    /// 0 Small, 1 Medium, 2 Large
    size: int,
    /// How a voice's words are cut into captions: 0 the phrases as heard,
    /// 1 a word at a time, 2 pairs, 3 short bursts, 4 sentences.
    grouping: int,
    /// How the word being said is lit: 0 not at all, 1 the word alone,
    /// 2 every word said so far.
    highlight: int,
    /// Row in the lit word's colours.
    highlight-colour: int,
    /// The format captions are written out in: 0 SRT, 1 VTT, 2 ASS, 3 TXT.
    format: int,
    running: bool,
    /// 0..1: where the transcription surely is.
    progress: float,
    /// Where the step under way leaves the bar, 0..1.
    ceiling: float,
    /// Seconds that step should take.
    step: float,
    /// Seconds of the run still to go, once the work has been timed;
    /// negative before.
    left: float,
    /// What the run is doing, in words.
    stage: string,
    /// A transcriber model is installed.
    ready: bool,
    /// Why the last run failed, when it did.
    message: string,
}

/// The sheet's body on its own: the Library's Text page shows it in place
/// on a desk, and the phone's sheet wraps it in a Modal. One body, so the
/// two never drift apart.
export component CaptionsForm inherits VerticalLayout {
    in property <CaptionsSheetData> data;
    /// The installed transcriber models, by name.
    in property <[string]> models;
    /// "Auto-detect", then every language the transcriber knows, each by
    /// its own name.
    in property <[string]> languages;

    callback voice-toggled(on: bool);
    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback language-changed(index: int);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    /// A row picked in one of the choices kept between runs: `which` is
    /// 0 for how the words are cut, 1 for how the spoken word is lit,
    /// 2 for its colour, 3 for the format captions are written out in.
    callback choice-changed(which: int, index: int);
    /// Give the captions already on the timeline the lit word chosen here.
    callback apply-highlight();
    /// Something done to row `index` of the transcript: 0 jump to it,
    /// 1 its words corrected to `text`, 2 join it with the next, 3 cut it
    /// in two, 4 delete it, 5 and 6 its start earlier and later, 7 and 8
    /// its end.
    callback row-action(action: int, index: int, text: string);
    callback begin();
    callback cancel();
    callback import-srt();
    callback export-srt();

    property <bool> from-voice: root.data.from-voice;
    /// The lit word's colours, in the rows' order.
    property <[color]> colours: [#ffe600, #39ff14, #00e5ff, #ff3d9a, #ff8a00, #ff3b30, #ffffff];

    // The script being typed, held apart from `data.text` the way the Field
    // primitive holds its draft: a TextInput's binding is dropped on the
    // first keystroke, so the form re-seeds it when the data changes and
    // never while it is being typed into.
    property <string> draft;
    /// The script has the caret. Kept up here because the box lives under
    /// an `if`, and nothing outside one can reach into it.
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
    }
    init => { root.draft = root.data.text; }

        // Where the words come from, first and in the same place whether
        // it is on or off: on, the clip and the transcriber are under its
        // switch; off, the script is the next group down.
        if !root.data.running: DialogSection {
            first: true;
            title: I18n.t("captions.transcribeClipVoice");
            switchable: true;
            on: root.from-voice;
            open: root.from-voice;
            switched(on) => { root.voice-toggled(on); }

            DialogRow {
                label: I18n.t("common.audio");
                Select {
                    options: root.data.sources;
                    current: root.data.source;
                    placeholder: I18n.t("captions.noVoiceOnTimeline");
                    enabled: root.data.sources.length > 0;
                    changed(index) => { root.source-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.model");
                Select {
                    options: root.models;
                    current: root.data.model;
                    placeholder: I18n.t("common.noneInstalled");
                    enabled: root.models.length > 0;
                    changed(index) => { root.model-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("captions.language");
                Select {
                    options: root.languages;
                    current: root.data.language;
                    enabled: !root.data.language-fixed && root.languages.length > 1;
                    changed(index) => { root.language-changed(index); }
                }
            }

            if !root.data.ready: Text {
                text: I18n.t("captions.downloadTranscriberModelFirst");
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        if !root.data.running && !root.from-voice: DialogSection {
            title: I18n.t("common.script");

            // Scrolls past its bottom and is drawn taller by its corner.
            script-box := ResizeBox {
                content-height: script.preferred-height;
                focused: script.has-focus;

                script := TextInput {
                    x: script-box.pad-x;
                    y: script-box.pad-y;
                    width: parent.width - self.x - 2 * script-box.pad-x;
                    height: Math.max(self.preferred-height, script-box.view-height);
                    cursor-position-changed(at) => { script-box.reveal(at.y, self.font-size * 1.4); }
                    text <=> root.draft;
                    color: Theme.fg;
                    font-size: Theme.fs-lg;
                    single-line: false;
                    wrap: char-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    changed has-focus => { root.typing = self.has-focus; }
                    edited => { root.text-edited(self.text); }
                    // Home and End are unbound in Slint on macOS and would
                    // walk up to the window's playhead shortcuts.
                    key-pressed(event) => {
                        if (event.text == Key.Home) {
                            self.set-selection-offsets(0, 0);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            self.set-selection-offsets(1000000000, 1000000000);
                            return accept;
                        }
                        return reject;
                    }
                }

                if root.draft == "" && !script.has-focus: Text {
                    x: 0;
                    y: script-box.pad-y;
                    text: I18n.t("captions.typeWordsPutScreen");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-lg;
                }
            }
        }

        if !root.data.running: DialogSection {
            title: I18n.t("captions.captions");

            // The look, from the Text page's presets; where it sits and
            // how big stay the captions' own, since a style's own size
            // and place are a title's, not a subtitle's.
            DialogRow {
                label: I18n.t("textPanel.style");
                StylePicker {
                    current: CaptionStyles.current;
                    matches: CaptionStyles.matches;
                    query-changed(text) => { CaptionStyles.query-changed(text); }
                    picked(id) => { CaptionStyles.picked(id); }
                }
            }

            DialogRow {
                label: I18n.t("captions.placement");
                SegmentedControl {
                    options: [I18n.t("common.bottom"), I18n.t("captions.centre"), I18n.t("common.top")];
                    current: root.data.placement;
                    changed(index) => { root.placement-changed(index); }
                }
            }

            DialogRow {
                label: I18n.t("common.size");
                SegmentedControl {
                    options: [I18n.t("common.small"), I18n.t("common.medium"), I18n.t("common.large")];
                    current: root.data.size;
                    changed(index) => { root.size-changed(index); }
                }
            }

            // How a voice's words become lines: a script has its own
            // sentences, so the choice is the voice's alone.
            if root.from-voice: DialogRow {
                label: I18n.t("captions.grouping");
                Select {
                    options: [
                        I18n.t("captions.groupPhrase"),
                        I18n.t("captions.groupWord"),
                        I18n.t("captions.groupPair"),
                        I18n.t("captions.groupBurst"),
                        I18n.t("captions.groupSentence"),
                    ];
                    current: root.data.grouping;
                    changed(index) => { root.choice-changed(0, index); }
                }
            }

            Text {
                text: !root.from-voice ? I18n.t("captions.oneTitlePerSentence")
                    : root.data.grouping == 0 ? I18n.t("captions.oneTitlePerPhrase")
                    : I18n.t("captions.cutToTheWords");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }

        // The word being said, lit: in preview and in the exported video.
        if !root.data.running: DialogSection {
            title: I18n.t("captions.wordHighlight");

            DialogRow {
                label: I18n.t("captions.highlightMode");
                Select {
                    options: [
                        I18n.t("captions.highlightNone"),
                        I18n.t("captions.highlightActive"),
                        I18n.t("captions.highlightFill"),
                    ];
                    current: root.data.highlight;
                    changed(index) => { root.choice-changed(1, index); }
                }
            }

            if root.data.highlight > 0: DialogRow {
                label: I18n.t("common.color");
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for colour[index] in root.colours: Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: colour;
                        border-width: root.data.highlight-colour == index ? 2px : 1px;
                        border-color: root.data.highlight-colour == index ? Theme.accent : Theme.line;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choice-changed(2, index); }
                        }
                    }
                }
            }

            Text {
                text: root.data.highlight == 0 ? I18n.t("captions.highlightNoneHelp")
                    : root.data.highlight == 1 ? I18n.t("captions.highlightActiveHelp")
                    : I18n.t("captions.highlightFillHelp");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            Button {
                block: true;
                ghost: true;
                glyph: Glyph.text-mark;
                label: I18n.t("captions.applyToExisting");
                clicked => { root.apply-highlight(); }
            }
        }

        // The transcript: every caption on the captions' lane, to read,
        // jump to, correct, cut, join and time.
        if !root.data.running && root.data.rows.length > 0: DialogSection {
            title: I18n.t("captions.transcript");

            Text {
                text: I18n.t("captions.transcriptHelp");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            for row[index] in root.data.rows: Rectangle {
                border-radius: Theme.r;
                background: row.current ? Theme.accent.with-alpha(0.14) : transparent;
                border-width: 1px;
                border-color: row.current ? Theme.accent : Theme.line;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 6px;

                        // The time is the way to the caption.
                        Rectangle {
                            width: 56px;
                            Text {
                                text: row.time;
                                color: row.current ? Theme.accent : Theme.fg-muted;
                                font-family: Theme.font-technical;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.row-action(0, index, ""); }
                            }
                        }

                        words := TextInput {
                            horizontal-stretch: 1;
                            text: row.text;
                            color: Theme.fg;
                            font-size: Theme.fs;
                            single-line: true;
                            selection-background-color: Theme.accent;
                            selection-foreground-color: Theme.on-accent;
                            accepted => {
                                root.row-action(1, index, self.text);
                                self.clear-focus();
                            }
                            changed has-focus => {
                                if (self.has-focus) {
                                    root.row-action(0, index, "");
                                } else {
                                    root.row-action(1, index, self.text);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;

                        IconButton {
                            text: "−";
                            label: I18n.t("captions.startEarlier");
                            clicked => { root.row-action(5, index, ""); }
                        }
                        IconButton {
                            text: "+";
                            label: I18n.t("captions.startLater");
                            clicked => { root.row-action(6, index, ""); }
                        }
                        Text {
                            text: row.time + " → " + row.until;
                            color: Theme.fg-dim;
                            font-family: Theme.font-technical;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                        IconButton {
                            text: "−";
                            label: I18n.t("captions.endEarlier");
                            clicked => { root.row-action(7, index, ""); }
                        }
                        IconButton {
                            text: "+";
                            label: I18n.t("captions.endLater");
                            clicked => { root.row-action(8, index, ""); }
                        }
                        Rectangle { width: 8px; }
                        IconButton {
                            glyph: Glyph.split;
                            label: I18n.t("captions.splitCaption");
                            clicked => { root.row-action(3, index, ""); }
                        }
                        IconButton {
                            glyph: Glyph.merge;
                            label: I18n.t("captions.mergeWithNext");
                            enabled: index + 1 < root.data.rows.length;
                            clicked => { root.row-action(2, index, ""); }
                        }
                        IconButton {
                            glyph: Glyph.trash;
                            label: I18n.t("captions.deleteCaption");
                            danger: true;
                            clicked => { root.row-action(4, index, ""); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if root.data.running: VerticalLayout {
                spacing: 8px;

                row := HorizontalLayout {
                    spacing: 8px;
                    // The time left, once the work has been timed: counted down
                    // from the last report, and gone in the last second.
                    property <int> left: Math.ceil(Math.max(0, root.data.left - bar.since / 1s));

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.stage;
                        color: Theme.fg;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    if root.data.left >= 0 && row.left > 0: Text {
                        text: I18n.t2("common.aboutLeft", "\{Math.floor(row.left / 60)}",
                            (Math.mod(row.left, 60) < 10 ? "0" : "") + "\{Math.mod(row.left, 60)}");
                        color: Theme.fg-dim;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "\{Math.floor(bar.shown * 100)}%";
                        color: Theme.fg-muted;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }

                bar := Progress {
                    value: root.data.progress;
                    ceiling: root.data.ceiling;
                    step: root.data.step * 1s;
                    live: true;
                }
            }

            if root.data.running: HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("common.cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }

            if !root.data.running: Button {
                block: true;
                primary: true;
                large: true;
                glyph: Glyph.text-mark;
                label: root.from-voice ? I18n.t("captions.generateCaptions") : I18n.t("captions.addCaptions");
                enabled: root.from-voice ? root.data.ready && root.data.source >= 0 : root.draft != "";
                clicked => { root.begin(); }
            }

            // Captions as a SubRip file: one read in as titles with the
            // look above, timed as the file says; or a lane of titles
            // written out: the selected title's lane, or with none
            // selected the lane with the most titles, the captions'.
            if !root.data.running: Button {
                block: true;
                ghost: true;
                glyph: Glyph.import;
                label: I18n.t("captions.importSrt");
                clicked => { root.import-srt(); }
            }

            // Written out as SubRip, WebVTT, ASS (with each word's time,
            // as karaoke tags) or plain text.
            if !root.data.running: HorizontalLayout {
                spacing: 8px;

                Select {
                    width: 92px;
                    options: ["SRT", "VTT", "ASS", "TXT"];
                    current: root.data.format;
                    changed(index) => { root.choice-changed(3, index); }
                }

                Button {
                    horizontal-stretch: 1;
                    block: true;
                    ghost: true;
                    glyph: Glyph.export;
                    label: I18n.t("captions.exportSubtitles");
                    clicked => { root.export-srt(); }
                }
            }
        }
}

export component CaptionsDialog inherits Modal {
    in property <CaptionsSheetData> data;
    in property <[string]> models;
    in property <[string]> languages;

    callback voice-toggled(on: bool);
    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback language-changed(index: int);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    callback choice-changed(which: int, index: int);
    callback apply-highlight();
    callback row-action(action: int, index: int, text: string);
    callback begin();
    callback cancel();
    callback import-srt();
    callback export-srt();

    open: root.data.open;
    title: I18n.t("captions.captions");
    glyph: Glyph.text-mark;
    surface-width: 480px;
    dismissable: !root.data.running;

    CaptionsForm {
        data: root.data;
        models: root.models;
        languages: root.languages;
        voice-toggled(on) => { root.voice-toggled(on); }
        source-changed(index) => { root.source-changed(index); }
        text-edited(text) => { root.text-edited(text); }
        model-changed(index) => { root.model-changed(index); }
        language-changed(index) => { root.language-changed(index); }
        placement-changed(index) => { root.placement-changed(index); }
        size-changed(index) => { root.size-changed(index); }
        choice-changed(which, index) => { root.choice-changed(which, index); }
        apply-highlight => { root.apply-highlight(); }
        row-action(action, index, text) => { root.row-action(action, index, text); }
        begin => { root.begin(); }
        cancel => { root.cancel(); }
        import-srt => { root.import-srt(); }
        export-srt => { root.export-srt(); }
    }
}
